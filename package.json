{
  "name": "a6",
  "version": "0.1.0",
  "private": true,
  "description": "A6 — AI-powered desktop integrated development environment",
  "license": "UNLICENSED",
  "author": "A6 Project",
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @a6/desktop dev",
    "start": "pnpm --filter @a6/desktop start",
    "build": "pnpm --filter @a6/desktop build",
    "package": "pnpm --filter @a6/desktop package",
    "make": "pnpm --filter @a6/desktop make",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node tools/verify/runtime.mjs",
    "verify:fuses": "node tools/verify/fuses.mjs",
    "verify:quitcleanup": "node tools/verify/quitcleanup.mjs",
    "verify:packaging": "node tools/verify/packaging.mjs",
    "verify:release": "node tools/release/checklist.mjs",
    "generate:notices": "node tools/release/generate-notices.mjs",
    "generate:icons": "electron tools/release/generate-icons.cjs",
    "perf:measure": "node tools/perf/measure.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
