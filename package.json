{
  "name": "nova-ide",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA IDE — AI-powered desktop integrated development environment",
  "license": "UNLICENSED",
  "author": "NOVA IDE Project",
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @nova/desktop dev",
    "start": "pnpm --filter @nova/desktop start",
    "build": "pnpm --filter @nova/desktop build",
    "package": "pnpm --filter @nova/desktop package",
    "make": "pnpm --filter @nova/desktop make",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node tools/verify/runtime.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
